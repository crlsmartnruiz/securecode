pipeline {
    agent any
    environment {
        OPENAI_API_KEY = sh 'aws secretsmanager get-secret-value --secret-id openai-key | jq -r ".SecretString" | jq ".apiKey"'
    }


    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(branches: [[name: '**']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/crlsmartnruiz/securecode']])
            }
        }
       

        stage('Build') {
            steps {
                dir('code') {
                    sh 'docker-compose --progress plain build'
                }
            }
        }
        stage('Test') {
            steps {
                dir('code') {
                    sh 'docker-compose --progress plain run --rm -e OPENAI_API_KEY=${OPENAI_API_KEY} server python -m pytest test.py -s'
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                sh 'echo "Subir imagen a un registry de imágenes"'
            }
        }
    }
}
