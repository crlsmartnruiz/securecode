pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(branches: [[name: '**']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/crlsmartnruiz/securecode']])
            }
        }
       
        stage('Build') {
            steps {
                dir('code') {
                    sh 'docker-compose --progress plain build'
                }
            }
        }
        stage('Test') {
            steps {
                dir('code') {
                    ansiColor('xterm') {
                        sh 'docker-compose --progress plain run --rm server python -m pytest test.py -s --color yes -vvv'
                    }
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                echo "Subir imagen a un registry de imágenes"
            }
        }
    }
}
